# Kronos 独立微服务配置
# 使用 Docker Compose 前，请将本文件复制为 .env。

# 网络配置
KRONOS_HOST=127.0.0.1
KRONOS_SERVICE_PORT=8101

# 默认模型：base 或 small
KRONOS_DEFAULT_MODEL=base

# 本地目录覆盖配置。保持注释时，默认使用 kronos_service/ 下的标准目录结构。
# KRONOS_SERVICE_ROOT=.
# KRONOS_SOURCE_DIR=.
# KRONOS_MODEL_ROOT=.

# 日志级别：DEBUG、INFO、WARNING 或 ERROR
KRONOS_LOG_LEVEL=INFO
